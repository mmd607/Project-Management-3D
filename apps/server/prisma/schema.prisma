// Conceptual model source: ai-project-workspace-phase0/04-data/DATA_MODEL.md
// Provenance categories source: ai-project-workspace-phase0/04-data/PROVENANCE_AND_CONFIDENCE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id           String    @id @default(uuid())
  rootPath     String    @unique
  displayName  String
  createdAt    DateTime  @default(now())
  lastScanAt   DateTime?
  scanPolicyId String    @default("v0-default")

  projects Project[]
}

model Project {
  id                  String    @id @default(uuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rootPath            String
  name                String
  discoveryConfidence String // DETERMINISTIC | INFERRED | UNKNOWN — see Provenance
  discoveredAt        DateTime  @default(now())
  lastScannedAt       DateTime?

  scanResults         ScanResult[]
  evidence            Evidence[]
  intelligenceProfile IntelligenceProfile?
  technologies        Technology[]
  recommendations     Recommendation[]

  @@unique([workspaceId, rootPath])
}

model ScanResult {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String // OK | PARTIAL | FAILED
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  fileCount      Int       @default(0)
  directoryCount Int       @default(0)
  totalSizeBytes Int       @default(0) // sum of scanned files' sizes; excludes skipped/excluded paths
  truncated      Boolean   @default(false)
  errors         String? // JSON-encoded array of {path, message}
}

model Evidence {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceType String // e.g. "manifest", "readme", "git", "language-file"
  sourcePath   String
  key          String
  value        String
  confidence   String // DETERMINISTIC | INFERRED | UNKNOWN
  createdAt    DateTime @default(now())
}

model IntelligenceProfile {
  id                  String   @id @default(uuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description         String
  category            String
  projectType         String
  architectureSummary String
  healthSummary       String
  generatedAt         DateTime @default(now())
  providerMode        String // "deterministic" | "mock" | "anthropic"
  confidence          String // DETERMINISTIC | INFERRED | AI_INFERRED | UNKNOWN
}

model Technology {
  id             String  @id @default(uuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  kind           String // language | framework | packageManager | tool
  evidenceSource String
  confidence     String // DETERMINISTIC | INFERRED | UNKNOWN
}

model Recommendation {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text        String
  rationale   String
  confidence  String // DETERMINISTIC | INFERRED | AI_INFERRED | UNKNOWN
  generatedAt DateTime @default(now())
}

model AiInsight {
  id          String   @id @default(uuid())
  projectId   String
  kind        String // "explain_project"
  providerMode String // "mock" | "anthropic"
  inputDigest String // hash of the context sent, for cache/debug — never the raw content
  outputText  String
  confidence  String // always AI_INFERRED
  createdAt   DateTime @default(now())
}
