{
  "name": "project-intelligence-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate -w apps/server",
    "prisma:generate": "npm run prisma:generate -w apps/server",
    "prisma:migrate": "npm run prisma:migrate -w apps/server",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "test": "npm run test -w apps/server && npm run test -w apps/web",
    "test:server": "npm run test -w apps/server",
    "test:web": "npm run test -w apps/web",
    "lint": "npm run lint -w apps/server && npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/web"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
