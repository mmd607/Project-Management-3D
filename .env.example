# Copy to apps/server/.env before running.

# SQLite file location (Prisma datasource URL format). Relative paths resolve
# relative to apps/server/prisma/, so this creates apps/server/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Server port.
PORT=4310

# AI provider: "mock" (default, deterministic, no network/API key) or "anthropic".
AI_PROVIDER=mock

# Only required when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Frontend dev server origin, for CORS in apps/server.
WEB_ORIGIN=http://localhost:5173
